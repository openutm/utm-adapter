<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="utm-adapter"
        Arguments=""
        InstallLocation="C:\Program Files\OpenUTM\UTM Adapter">
    </Installer>
    <PackageInformation
        PackageName="UTM Adapter"
        PackageDisplayName="UTM Adapter"
        PublisherName="CN=OpenUTM"
        PublisherDisplayName="OpenUTM"
        Version="0.2.0.0"
        PackageDescription="Ground control to Flight Blender">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="org.openutm.adapter"
                Description="Ground control to Flight Blender"
                DisplayName="UTM Adapter"
                ExecutableName="utm-adapter"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>UTM Adapter</DisplayName>
            <PublisherDisplayName>OpenUTM</PublisherDisplayName>
            <Description>Ground control to Flight Blender</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="utm-adapter.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
